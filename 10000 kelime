def build_ten_thousand_word_corpus(target_words: int = 10000) -> str:
    """Öğretici ders bloklarını birleştirerek ~10.000 kelimelik metin üretir."""
    chunks = []
    current_words = 0
    lesson_idx = 0
    total_lessons = len(BASE_LESSONS)

    while current_words < target_words:
        lesson = BASE_LESSONS[lesson_idx % total_lessons]
        lesson_words = lesson.split()
        remaining = target_words - current_words

        if len(lesson_words) <= remaining:
            chunks.append(lesson)
            current_words += len(lesson_words)
        else:
            chunks.append(" ".join(lesson_words[:remaining]))
            current_words += remaining

        lesson_idx += 1

    return " ".join(chunks)


