import os
import sqlite3
import numpy as np
from flask import Flask, request, redirect, session, render_template_string, url_for, flash, jsonify
from werkzeug.security import generate_password_hash, check_password_hash
from collections import defaultdict
import random
import re

app = Flask(__name__)
app.secret_key = os.environ.get("SECRET_KEY", "mini-ai-secret-key-2026-degistir")

DB_FILE = "app.db"
MODEL_DIR = "model_data"
os.makedirs(MODEL_DIR, exist_ok=True)

# ======================
# VERİTABANI
# ======================
def get_db():
    conn = sqlite3.connect(DB_FILE)
    conn.row_factory = sqlite3.Row
    return conn

def init_db():
    conn = get_db()
    conn.execute("""
        CREATE TABLE IF NOT EXISTS users (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            username TEXT UNIQUE NOT NULL,
            password_hash TEXT NOT NULL,
            role TEXT NOT NULL DEFAULT 'user'
        )
    """)
    conn.execute("""
        CREATE TABLE IF NOT EXISTS sentences (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            username TEXT NOT NULL,
            text TEXT NOT NULL,
            used_in_training INTEGER DEFAULT 0
        )
    """)
    conn.commit()

    existing_admin = conn.execute("SELECT * FROM users WHERE role='admin'").fetchone()
    if not existing_admin:
        conn.execute(
            "INSERT INTO users (username, password_hash, role) VALUES (?, ?, ?)",
            ("admin", generate_password_hash("admin123"), "admin")
        )
        conn.commit()
        print(">>> Varsayılan admin: admin / admin123  (hemen değiştir!)")
    conn.close()

init_db()

# ======================
# MODEL AYARLARI
# ======================
HIDDEN_SIZE = 96
SEQ_LEN = 20
LR = 0.003

BASE_TEXT = """
selam merhaba nasilsin iyiyim tesekkurler sen nasilsin
ben mini ai yapay zeka modeliyim seninle sohbet etmek icin buradayim
yapay zeka veriden oruntu ogrenir sinir aglari katmanlardan olusur
gradyan inisi hatayi azaltmak icin agirliklari gunceller
adam optimizatoru ogrenme adimlarini dengeler
tekrarlayan sinir aglari onceki bilgiyi sonraki adima tasir
aktivasyon fonksiyonlari dogrusal olmayan iliskileri ogrenmeyi saglar
softmax skorlari olasiliklara cevirir temperature cesitliligi ayarlar
model ne kadar cok ornek gorurse o kadar iyi tahmin eder
python ile numpy kullanarak sifirdan model yazmak egiticidir
kod yazmak sabir ister ama her gun ilerleme kaydedilir
bugun ne ogrenmek istersin hangi konuda konusmak istersin
anlamadim tekrar soyler misin daha acik yazar misin
cok guzel soru sordun tesekkur ederim
""".strip().lower()

model_state = {}
training_in_progress = {"flag": False}

def get_all_training_text():
    conn = get_db()
    rows = conn.execute("SELECT text FROM sentences").fetchall()
    conn.close()
    extra = "\n".join(r["text"] for r in rows)
    return (BASE_TEXT + "\n" + extra).lower()

def build_vocab(text):
    chars = sorted(list(set(text)))
    char_to_idx = {ch: i for i, ch in enumerate(chars)}
    idx_to_char = {i: ch for i, ch in enumerate(chars)}
    return char_to_idx, idx_to_char, len(chars)

def init_weights(vocab_size):
    rng = np.random.default_rng(42)
    scale = 0.08
    return {
        "Wxh": rng.standard_normal((HIDDEN_SIZE, vocab_size)) * scale,
        "Whh": rng.standard_normal((HIDDEN_SIZE, HIDDEN_SIZE)) * scale,
        "Why": rng.standard_normal((vocab_size, HIDDEN_SIZE)) * scale,
        "bh": np.zeros((HIDDEN_SIZE, 1)),
        "by": np.zeros((vocab_size, 1)),
    }

def load_or_init_model():
    text = get_all_training_text()
    char_to_idx, idx_to_char, vocab_size = build_vocab(text)

    paths = {w: os.path.join(MODEL_DIR, w + ".npy") for w in ["Wxh", "Whh", "Why", "bh", "by"]}
    all_exist = all(os.path.exists(p) for p in paths.values())

    if all_exist:
        loaded = {w: np.load(paths[w]) for w in paths}
        if loaded["Wxh"].shape[1] != vocab_size:
            print("Vocab değişti, ağırlıklar yeniden başlatılıyor...")
            loaded = init_weights(vocab_size)
    else:
        loaded = init_weights(vocab_size)

    model_state["weights"] = loaded
    model_state["char_to_idx"] = char_to_idx
    model_state["idx_to_char"] = idx_to_char
    model_state["vocab_size"] = vocab_size
    model_state["text"] = text

load_or_init_model()

def softmax(x):
    e = np.exp(x - np.max(x))
    return e / np.sum(e)

def sample_top_k(logits, temperature=0.6, top_k=6):
    temp = max(temperature, 0.05)
    scaled = (logits.ravel() / temp).astype(np.float64)
    k = min(max(1, top_k), len(scaled))
    top_indices = np.argpartition(scaled, -k)[-k:]
    top_logits = scaled[top_indices]
    top_logits = top_logits - np.max(top_logits)
    probs = np.exp(top_logits)
    probs = probs / np.sum(probs)
    return int(np.random.choice(top_indices, p=probs))

def generate_text(start_text, length=90, temperature=0.55, top_k=5):
    w = model_state["weights"]
    c2i = model_state["char_to_idx"]
    i2c = model_state["idx_to_char"]
    vocab_size = model_state["vocab_size"]

    clean = "".join([c for c in start_text.lower() if c in c2i])
    if not clean:
        return "Bu karakterleri henüz tanımıyorum. Bana öğret!"

    h = np.zeros((HIDDEN_SIZE, 1))
    result = list(clean)

    # Seed'i gizli duruma besle
    for ch in clean:
        idx = c2i[ch]
        x = np.zeros((vocab_size, 1))
        x[idx] = 1.0
        h = np.tanh(w["Wxh"] @ x + w["Whh"] @ h + w["bh"])

    last_idx = c2i[clean[-1]]

    for _ in range(length):
        x = np.zeros((vocab_size, 1))
        x[last_idx] = 1.0
        h = np.tanh(w["Wxh"] @ x + w["Whh"] @ h + w["bh"])
        logits = w["Why"] @ h + w["by"]
        next_idx = sample_top_k(logits, temperature=temperature, top_k=top_k)
        result.append(i2c[next_idx])
        last_idx = next_idx

    text = "".join(result)
    # Biraz temizlik
    text = re.sub(r'\s+', ' ', text).strip()
    return text

def train_model(epochs=120):
    if training_in_progress["flag"]:
        return
    training_in_progress["flag"] = True
    try:
        load_or_init_model()
        w = model_state["weights"]
        c2i = model_state["char_to_idx"]
        vocab_size = model_state["vocab_size"]
        text = model_state["text"]
        data = np.array([c2i[ch] for ch in text if ch in c2i])

        Wxh, Whh, Why, bh, by = w["Wxh"].copy(), w["Whh"].copy(), w["Why"].copy(), w["bh"].copy(), w["by"].copy()

        m = {k: np.zeros_like(v) for k, v in w.items()}
        v = {k: np.zeros_like(v) for k, v in w.items()}
        beta1, beta2, eps = 0.9, 0.999, 1e-8
        step = 0

        def adam(param, dparam, m_arr, v_arr, t):
            m_arr[:] = beta1 * m_arr + (1 - beta1) * dparam
            v_arr[:] = beta2 * v_arr + (1 - beta2) * (dparam ** 2)
            mc = m_arr / (1 - beta1 ** t)
            vc = v_arr / (1 - beta2 ** t)
            param -= LR * mc / (np.sqrt(vc) + eps)
            return param

        print(f"Eğitim başlıyor ({epochs} epoch)...")
        for epoch in range(1, epochs + 1):
            h = np.zeros((HIDDEN_SIZE, 1))
            for i in range(0, len(data) - SEQ_LEN - 1, SEQ_LEN):
                step += 1
                inputs = data[i:i+SEQ_LEN]
                targets = data[i+1:i+SEQ_LEN+1]

                xs, hs, ps = {}, {-1: h}, {}
                for t in range(len(inputs)):
                    xs[t] = np.zeros((vocab_size, 1))
                    xs[t][inputs[t]] = 1.0
                    hs[t] = np.tanh(Wxh @ xs[t] + Whh @ hs[t-1] + bh)
                    ys = Why @ hs[t] + by
                    ps[t] = softmax(ys)

                dWxh = np.zeros_like(Wxh)
                dWhh = np.zeros_like(Whh)
                dWhy = np.zeros_like(Why)
                dbh = np.zeros_like(bh)
                dby = np.zeros_like(by)
                dh_next = np.zeros_like(hs[0])

                for t in reversed(range(len(xs))):
                    dy = ps[t].copy()
                    dy[targets[t]] -= 1
                    dWhy += dy @ hs[t].T
                    dby += dy
                    dh = Why.T @ dy + dh_next
                    dh_raw = (1 - hs[t]**2) * dh
                    dbh += dh_raw
                    dWxh += dh_raw @ xs[t].T
                    dWhh += dh_raw @ hs[t-1].T
                    dh_next = Whh.T @ dh_raw

                for d in [dWxh, dWhh, dWhy, dbh, dby]:
                    np.clip(d, -4, 4, out=d)

                Wxh = adam(Wxh, dWxh, m["Wxh"], v["Wxh"], step)
                Whh = adam(Whh, dWhh, m["Whh"], v["Whh"], step)
                Why = adam(Why, dWhy, m["Why"], v["Why"], step)
                bh = adam(bh, dbh, m["bh"], v["bh"], step)
                by = adam(by, dby, m["by"], v["by"], step)

                h = hs[len(inputs)-1]

            if epoch % 30 == 0 or epoch == epochs:
                print(f"Epoch {epoch}/{epochs} tamamlandı")

        # Kaydet
        np.save(os.path.join(MODEL_DIR, "Wxh.npy"), Wxh)
        np.save(os.path.join(MODEL_DIR, "Whh.npy"), Whh)
        np.save(os.path.join(MODEL_DIR, "Why.npy"), Why)
        np.save(os.path.join(MODEL_DIR, "bh.npy"), bh)
        np.save(os.path.join(MODEL_DIR, "by.npy"), by)

        model_state["weights"] = {"Wxh": Wxh, "Whh": Whh, "Why": Why, "bh": bh, "by": by}

        conn = get_db()
        conn.execute("UPDATE sentences SET used_in_training = 1")
        conn.commit()
        conn.close()
        print("Eğitim bitti, ağırlıklar kaydedildi.")
    finally:
        training_in_progress["flag"] = False

# ======================
# HTML
# ======================
LAYOUT = """
<!doctype html>
<html lang="tr">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Mini AI</title>
<style>
body { font-family: system-ui, sans-serif; max-width: 520px; margin: 20px auto; padding: 0 16px; background:#0f0f0f; color:#eee; }
input, textarea, button { width: 100%; padding: 12px; margin: 8px 0; box-sizing: border-box; border-radius: 10px; border: 1px solid #333; background:#1a1a1a; color:#eee; font-size: 16px; }
button { background: #22c55e; color: white; border: none; cursor: pointer; font-weight: 600; }
button:active { transform: scale(0.98); }
a { color: #60a5fa; }
.msg-model { background:#1e293b; padding:12px; border-radius:12px; margin:12px 0; line-height:1.5; }
.topbar { display:flex; justify-content: space-between; align-items:center; margin-bottom: 20px; }
.flash { background:#7c2d12; padding:10px; border-radius:8px; margin:10px 0; }
h2, h3 { margin: 0 0 12px 0; }
</style>
</head>
<body>
<div class="topbar">
  <h2>Mini AI</h2>
  <div>
  {% if session.get('username') %}
    {{ session['username'] }} ({{ session['role'] }}) | <a href="{{ url_for('logout') }}">Çıkış</a>
  {% else %}
    <a href="{{ url_for('login') }}">Giriş</a>
  {% endif %}
  </div>
</div>
{% with messages = get_flashed_messages() %}
  {% for m in messages %}<div class="flash">{{ m }}</div>{% endfor %}
{% endwith %}
{{ body|safe }}
</body>
</html>
"""

def render(body_html, **kwargs):
    return render_template_string(LAYOUT, body=render_template_string(body_html, **kwargs))

# ======================
# ROTALAR
# ======================
@app.route("/register", methods=["GET", "POST"])
def register():
    if request.method == "POST":
        username = request.form["username"].strip()
        password = request.form["password"]
        if not username or not password:
            flash("Kullanıcı adı ve şifre boş olamaz.")
            return redirect(url_for("register"))
        conn = get_db()
        if conn.execute("SELECT * FROM users WHERE username=?", (username,)).fetchone():
            flash("Bu kullanıcı adı zaten alınmış.")
            conn.close()
            return redirect(url_for("register"))
        conn.execute("INSERT INTO users (username, password_hash, role) VALUES (?, ?, 'user')",
                     (username, generate_password_hash(password)))
        conn.commit()
        conn.close()
        flash("Kayıt başarılı, giriş yapabilirsin.")
        return redirect(url_for("login"))
    return render("""
    <h3>Kayıt Ol</h3>
    <form method="post">
      <input name="username" placeholder="Kullanıcı adı" required>
      <input name="password" type="password" placeholder="Şifre" required>
      <button type="submit">Kayıt Ol</button>
    </form>
    <p>Zaten hesabın var mı? <a href="{{ url_for('login') }}">Giriş yap</a></p>
    """)

@app.route("/login", methods=["GET", "POST"])
def login():
    if request.method == "POST":
        username = request.form["username"].strip()
        password = request.form["password"]
        conn = get_db()
        user = conn.execute("SELECT * FROM users WHERE username=?", (username,)).fetchone()
        conn.close()
        if user and check_password_hash(user["password_hash"], password):
            session["username"] = user["username"]
            session["role"] = user["role"]
            return redirect(url_for("index"))
        flash("Kullanıcı adı veya şifre hatalı.")
        return redirect(url_for("login"))
    return render("""
    <h3>Giriş Yap</h3>
    <form method="post">
      <input name="username" placeholder="Kullanıcı adı" required>
      <input name="password" type="password" placeholder="Şifre" required>
      <button type="submit">Giriş Yap</button>
    </form>
    <p>Hesabın yok mu? <a href="{{ url_for('register') }}">Kayıt ol</a></p>
    """)

@app.route("/logout")
def logout():
    session.clear()
    return redirect(url_for("login"))

def login_required(role=None):
    if "username" not in session:
        return False
    if role and session.get("role") != role:
        return False
    return True

@app.route("/", methods=["GET", "POST"])
def index():
    if not login_required():
        return redirect(url_for("login"))

    model_reply = None
    if request.method == "POST":
        action = request.form.get("action")
        user_text = request.form.get("text", "").strip()

        if action == "ask" and user_text:
            # Biraz daha tutarlı üretim için düşük temperature
            model_reply = generate_text(user_text, length=80, temperature=0.5, top_k=4)

        elif action == "teach" and user_text:
            conn = get_db()
            conn.execute("INSERT INTO sentences (username, text) VALUES (?, ?)",
                         (session["username"], user_text.lower()))
            conn.commit()
            conn.close()
            flash("Teşekkürler! Cümlen kaydedildi. Admin eğitimi başlattığında modele eklenecek.")

    return render("""
    <h3>Modelle konuş</h3>
    <form method="post">
      <textarea name="text" rows="3" placeholder="Bir kelime veya cümle yaz..." required></textarea>
      <button type="submit" name="action" value="ask">Sor / Devamını Üret</button>
      <button type="submit" name="action" value="teach" style="background:#3b82f6">Modele Öğret</button>
    </form>
    {% if model_reply %}
    <div class="msg-model"><b>Model:</b><br>{{ model_reply }}</div>
    {% endif %}
    {% if session['role'] == 'admin' %}
    <p style="margin-top:24px"><a href="{{ url_for('admin_panel') }}">Admin paneline git →</a></p>
    {% endif %}
    """, model_reply=model_reply)

@app.route("/admin", methods=["GET", "POST"])
def admin_panel():
    if not login_required(role="admin"):
        flash("Bu sayfaya sadece admin erişebilir.")
        return redirect(url_for("index"))

    if request.method == "POST" and request.form.get("action") == "retrain":
        if training_in_progress["flag"]:
            flash("Zaten bir eğitim devam ediyor, bekle.")
        else:
            train_model(epochs=100)
            flash("Eğitim tamamlandı, model güncellendi.")

    conn = get_db()
    sentences = conn.execute("SELECT * FROM sentences ORDER BY id DESC LIMIT 50").fetchall()
    users = conn.execute("SELECT username, role FROM users").fetchall()
    conn.close()

    rows_html = "".join(
        f"<div style='background:#1e293b;padding:8px;border-radius:8px;margin:6px 0'>"
        f"[{'✓ eğitildi' if s['used_in_training'] else 'bekliyor'}] "
        f"<b>{s['username']}</b>: {s['text']}</div>"
        for s in sentences
    )
    users_html = "".join(f"<div>{u['username']} ({u['role']})</div>" for u in users)

    return render("""
    <h3>Admin Paneli</h3>
    <form method="post">
      <button type="submit" name="action" value="retrain">Modeli Şimdi Yeniden Eğit</button>
    </form>
    <h4 style="margin-top:24px">Kayıtlı Kullanıcılar</h4>
    {{ users_html|safe }}
    <h4 style="margin-top:20px">Öğretilen Cümleler (son 50)</h4>
    {{ rows_html|safe }}
    <p style="margin-top:24px"><a href="{{ url_for('index') }}">← Sohbete dön</a></p>
    """, rows_html=rows_html, users_html=users_html)

# App Inventor / API için basit endpoint (isteğe bağlı)
@app.route("/api/ask", methods=["POST"])
def api_ask():
    data = request.get_json(force=True, silent=True) or {}
    text = data.get("text", "").strip()
    if not text:
        return jsonify({"answer": "Boş mesaj"})
    answer = generate_text(text, length=70, temperature=0.5, top_k=4)
    return jsonify({"answer": answer})

if __name__ == "__main__":
    port = int(os.environ.get("PORT", 5000))
    app.run(host="0.0.0.0", port=port)
