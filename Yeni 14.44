from flask import Flask, request, jsonify
from flask_cors import CORS
import json
import os
import random
import re
from collections import defaultdict

app = Flask(__name__)
CORS(app)  # App Inventor üçün lazımdır

# ======================
# MƏLUMATLARI SAXLAMA
# ======================
DATA_FILE = "memory.json"

def load_memory():
    if os.path.exists(DATA_FILE):
        with open(DATA_FILE, "r", encoding="utf-8") as f:
            return json.load(f)
    return {"qa": {}, "markov": {}}

def save_memory(memory):
    with open(DATA_FILE, "w", encoding="utf-8") as f:
        json.dump(memory, f, ensure_ascii=False, indent=2)

memory = load_memory()

# ======================
# MARKOV ZƏNCİRİ
# ======================
def train_markov(text, order=2):
    words = text.lower().split()
    if len(words) < order + 1:
        return
    for i in range(len(words) - order):
        key = " ".join(words[i:i+order])
        next_word = words[i+order]
        if key not in memory["markov"]:
            memory["markov"][key] = []
        memory["markov"][key].append(next_word)

def generate_markov(seed="", max_words=25):
    if not memory["markov"]:
        return None
    
    words = seed.lower().split() if seed else []
    
    # Seed-dən başlamağa çalış
    if len(words) >= 2:
        key = " ".join(words[-2:])
        if key in memory["markov"]:
            current = key
        else:
            current = random.choice(list(memory["markov"].keys()))
    else:
        current = random.choice(list(memory["markov"].keys()))
    
    result = current.split()
    
    for _ in range(max_words):
        if current not in memory["markov"]:
            break
        next_word = random.choice(memory["markov"][current])
        result.append(next_word)
        current = " ".join(result[-2:])
    
    return " ".join(result)

# ======================
# SADƏ OXŞARLIQ
# ======================
def clean(text):
    text = text.lower().strip()
    text = re.sub(r'[^\w\s]', '', text)
    return text

def find_best_answer(question):
    q = clean(question)
    
    # 1. Tam uyğunluq
    if q in memory["qa"]:
        return random.choice(memory["qa"][q])
    
    # 2. Söz oxşarlığı (ən yaxşı uyğunluq)
    best_score = 0
    best_answers = []
    
    q_words = set(q.split())
    
    for known_q, answers in memory["qa"].items():
        known_words = set(known_q.split())
        common = len(q_words & known_words)
        score = common / max(len(q_words), 1)
        
        if score > best_score and score >= 0.4:  # 40% oxşarlıq
            best_score = score
            best_answers = answers
    
    if best_answers:
        return random.choice(best_answers)
    
    return None

# ======================
# FALLBACK CAVABLAR
# ======================
FALLBACKS = [
    "Başa düşmədim, bir az daha aydın yaza bilərsən?",
    "Maraqlı sualdır, amma hələ öyrənməmişəm. Mənə öyrət!",
    "Hmm... bu haqda düşünürəm. Başqa cür soruşsan?",
    "Hələ bu mövzunu bilmirəm. 'Modele Öğret' düyməsi ilə öyrədə bilərsən.",
    "Anlamadım. Daha sadə cümlə ilə yaza bilərsən?",
    "Gözəl sual! Amma mənim yaddaşıma hələ düşməyib."
]

# ======================
# ENDPOINT-LƏR
# ======================

@app.route("/")
def home():
    return "Mini AI Backend işləyir! 🚀"

@app.route("/ask", methods=["POST"])
def ask():
    data = request.get_json(force=True, silent=True) or {}
    question = data.get("text", "").strip()
    
    if not question:
        return jsonify({"answer": "Heç nə yazmamısan 😊"})
    
    # 1. Öyrədilmiş cavab axtar
    answer = find_best_answer(question)
    
    # 2. Yoxdursa Markov-la yarat
    if not answer:
        markov_ans = generate_markov(question)
        if markov_ans and len(markov_ans.split()) > 3:
            answer = markov_ans
        else:
            answer = random.choice(FALLBACKS)
    
    return jsonify({"answer": answer})

@app.route("/teach", methods=["POST"])
def teach():
    data = request.get_json(force=True, silent=True) or {}
    question = data.get("question", "").strip()
    answer = data.get("answer", "").strip()
    
    if not question or not answer:
        return jsonify({"status": "error", "message": "Sual və cavab lazımdır"})
    
    q_clean = clean(question)
    
    if q_clean not in memory["qa"]:
        memory["qa"][q_clean] = []
    
    if answer not in memory["qa"][q_clean]:
        memory["qa"][q_clean].append(answer)
    
    # Markov-a da öyrət
    train_markov(question + " " + answer)
    
    save_memory(memory)
    
    return jsonify({
        "status": "ok",
        "message": f"Öyrəndim! İndi '{question}' deyəndə cavab verəcəyəm."
    })

@app.route("/memory", methods=["GET"])
def show_memory():
    return jsonify({
        "qa_count": len(memory["qa"]),
        "markov_keys": len(memory["markov"]),
        "qa": memory["qa"]
    })

@app.route("/reset", methods=["POST"])
def reset():
    global memory
    memory = {"qa": {}, "markov": {}}
    save_memory(memory)
    return jsonify({"status": "ok", "message": "Yaddaş təmizləndi"})

if __name__ == "__main__":
    port = int(os.environ.get("PORT", 5000))
    app.run(host="0.0.0.0", port=port)
